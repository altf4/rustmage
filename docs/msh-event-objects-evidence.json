  "rules_evidence": [
    {
      "url": "https://magic.wizards.com/en/news/feature/marvel-super-heroes-release-notes",
      "published": "2026-06-12",
      "document_last_modified": "2026-05-14",
      "read_sections": [
        "Hawkeye's Bow",
        "Hulkling, Burgeoning Bruiser"
      ],
      "summary": "Bow requires an actual untapped-to-tapped transition. Hulkling compares matching statistics, checks again on resolution, includes entry counters and uses the departed entrant's last battlefield statistics. Multiple entries create separate checks; the qualifying axis may change."
    },
    {
      "url": "https://media.wizards.com/2026/downloads/MagicCompRules%2020260925.txt",
      "effective": "2026-09-25",
      "rules": [
        "113.7a",
        "113.8",
        "208.3",
        "400.7",
        "603.4",
        "603.6a-b",
        "608.2a",
        "608.2h",
        "608.2k",
        "701.26a",
        "702.15b-d",
        "702.100a-d"
      ],
      "summary": "Ability source and controller are fixed independently of a specified damage actor. Specific objects use current or latest-departure information. Intervening conditions are checked twice. Entry observers see the resulting battlefield. New incarnations are distinct. Noncreatures have no power or toughness. Lifelink uses the damage actor's controller and applicable current or last-known ability. Evolve uses a strict comparison on either matching axis."
    }
  ],
  "source_discrepancies": [
    {
      "card": "Hawkeye's Bow",
      "status": "confirmed direct/helper mismatch with Oracle and CR 608.2h",
      "detail": "DamagePlayersEffect constructor sourceName=\"it\" changes displayed text only; apply passes source.getSourceId() to player.damage. Bow owns the trigger, so Java deals damage from Bow instead of the equipped event creature. Rust must keep Bow as ability source while passing the separate exact creature as damage actor."
    },
    {
      "card": "Hulkling, Burgeoning Bruiser",
      "status": "representation hazard; no unverified failing-Java claim",
      "detail": "Pinned Java stores a mutable Permanent in effect.values for the entrant and copies that value shallowly through EffectImpl. It explicitly obtains source current/LKI but does not explicitly re-resolve the entrant by incarnation/current-or-departure reference. Rust must implement explicit signed current/latest-departure facts for both objects. Its custom ability is evolve-like but is not the evolve keyword: do not emit an EVOLVED_CREATURE event merely because a counter is added."
    }
  ],
  "shared_mechanics": [
    "An optional owned SpellView.event_object binds an exact independent untargeted event object, distinct from the ability source. Damage actor or signed creature-comparison variants expose only public battlefield facts; absent contexts omit serialization and allocation.",
    "Bow remains the trigger source. Its captured ability controller selects opponents, while the exact event creature supplies current or latest-departure damage facts, controller, keywords and colors through the existing damage/lifelink pipeline.",
    "Both source comparison and independent entrant comparison use signed i128 power or toughness, require both objects to be creatures, and check strict matching-axis OR when the event occurs and again on resolution. The satisfying axis may change.",
    "Every whole battlefield departure commit captures selected source and event facts before any object in the batch moves. Stack, pending, ordering, resolving, announcing and nested mana announcements retain owned context; new incarnations never replace the saved event object.",
    "Existing tap observer index handles attached-creature taps without imposing a shared controller requirement. Typed equip, static reach and power boost, counter placement, normal damage prevention/replacement, vigilance and mana funding are reused. No fake combat or evolved event, no hot Object field, no parser or bot."
  ],
  "wire": {
    "previous": 144,
    "current": 145,
    "reason": "Actual opt-in public event-object and signed source comparison payloads; coordinated shared version with this authoring wave"
  },
