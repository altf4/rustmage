  "contracts": {
    "event": "All real activation routes commit only after complete costs. Copies never fire; source need not survive its own costs. Graveyard observer zones are explicit.",
    "history": "One public boolean per player, recorded before providers enter, reset at the actual turn boundary. Selective mana rollback keeps it only for retained original mana events and reuses recorded observer packets.",
    "reuse": "Starting authorization is frozen on the exact enclosing announcement. New projected mana activations use current projected provider/history, consume permission and cannot waive independent once-per-turn limits. Spent bits/borrowed slots remain spent.",
    "reductions": "Generic-only, only exhaust, only other controlled battlefield permanents, additive across available live providers. Actual and speculative worlds use the same query.",
    "copy": "One source-independent delayed packet for next own nonmana exhaust activation until cleanup; retains captured packet/LKI and existing optional retarget state. Spells and mana exhaust leave it pending.",
    "grants": "External grant histories qualified by recipient, grantor, immutable definition, ability index and origin. Distinct grantors do not collide with recipient printed bits; departures discard rows."
  },
  "tests": {
    "target": "dft_exhaust_engine",
    "cases": [
      "actual_exhaust_events_include_mana_and_graveyard_observers_but_not_other_activations",
      "refueler_permission_is_own_turn_before_first_event_and_never_clears_spent_history",
      "projected_mana_consumes_one_reuse_but_preserves_enclosing_starting_authorization",
      "exhaust_discounts_stack_for_other_controlled_sources_and_recheck_suppression",
      "next_nonmana_exhaust_copy_is_independent_from_source_and_ignores_mana_and_spells",
      "delayed_exhaust_copy_allows_retarget_and_owned_raw_index_restore",
      "copied_or_countered_exhaust_packets_do_not_emit_extra_events_and_cleanup_expires_delay",
      "external_exhaust_grants_keep_separate_use_keys_from_recipient_and_other_grantors",
      "exhaust_event_waits_for_every_suspended_activation_cost_and_survives_countering",
      "distinct_borrowed_exhaust_abilities_retain_donor_slot_history_and_reuse_independently",
      "kept_mana_rollback_preserves_exhaust_event_fact_and_exact_original_observer_packet"
    ],
