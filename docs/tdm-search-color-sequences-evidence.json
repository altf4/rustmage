  "groups": [
    {
      "id": "A06",
      "card": "Breaching Dragonstorm",
      "support": "ExileUntilNonlandCastOrHand: sequential actual library exiles, first actual nonland stops independently of mana value; chosen spell face must meet inclusive 8 bound for immediate free cast, otherwise that exact remaining incarnation goes to owner hand. Other exiles remain exiled. Existing own-Dragon-entry return uses exact independent source incarnation.",
      "focused_cases": 6
    },
    {
      "id": "A07",
      "card": "Call the Spirit Dragons",
      "support": "PutColorCountersAndWin: mandatory-if-possible nontarget WUBRG choices use actual controlled subtype/color; same multicolor permanent may fill several roles. All choices aggregate into one simultaneous explicit-player replacement-aware counter batch. Freeze distinct actual positive successful recipients and invoke existing win rules at five; quantities/selections do not inflate recipients. Existing controlled keyword provider supplies printed Dragon indestructible during card authorship.",
      "focused_cases": 6
    },
    {
      "id": "A21",
      "card": "Glacial Dragonhunt",
      "support": "MayDiscardNonlandReflexive: draw instruction precedes optional private one-card hand choice. Actual nonland discard events queue a counterable targeted reflexive packet; redirected public exile still discarded, prevention is not. Existing Harmonize retains facts/source identity after source exile.",
      "focused_cases": 5
    },
    {
      "id": "B:distinct_color_search",
      "card": "Lotuslight Dancers",
      "support": "SearchDistinctColors reuses one optional private search with one shuffle; bounded 32-mask matching reassigns multicolor roles without greedy commitment. Any subset may fail to find, but one physical card fills only one distinct black/green/blue role.",
      "focused_cases": 3
    },
    {
      "id": "B:chosen_x_library_search",
      "card": "Nature's Rhythm",
      "support": "SearchCreaturesUpToChosenX binds creature mana value to locked spellX independently of one-card cardinality. Existing search entry batch handles chosen exact card and normal entry/SBAs. Existing symbol-X/Harmonize machinery is composed through a paid physical fixture, including X=0.",
      "focused_cases": 2
    },
    {
      "id": "C:SCALED_DAMAGE_DIVISION",
      "card": "Ureni, the Song Unending",
      "support": "DamageDividedScaled samples quantity once at target announcement into rare boxed packet data, bounds recipients by positive shares and supportszero targets. Announced exact targets/shares survive source departure, library/land changes and ability copies; illegal/blinked targets lose only their own shares. Creature and planeswalker legality remains ordinary targeting. Existing flying/color protection providers cover other printed lines during card authorship.",
      "focused_cases": 6
    }
  ],
  "rules_sources": [
    {
      "url": "https://magic.wizards.com/en/news/feature/tarkir-dragonstorm-release-notes",
