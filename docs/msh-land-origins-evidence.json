  "printed_obligations": {
    "Ka-Zar": [
      "Legendary green 3/2 Human Barbarian Hero, {4}{G}.",
      "Controller may look at the current library top any time, subject to CR 401.5 deferral.",
      "Controller may play owned land cards from the current library top using normal land timing and the shared turn allowance.",
      "Its enters trigger creates the exact legendary Zabu recipe for the captured trigger controller."
    ],
    "Mole Man": [
      "Legendary green 1/1 Human Villain, {2}{G}.",
      "Controller may play owned land cards from their graveyard using normal land timing and shared allowance; no per-source limit or graveyard spell permission.",
      "Whenever a land the controller controls enters, create the exact Moloid recipe."
    ],
    "Zabu": [
      "Legendary green 2/2 Cat.",
      "Whenever a land its controller controls enters, put one +1/+1 counter on the exact source incarnation."
    ],
    "Moloid": [
      "Green 1/1 Minion.",
      "When this creature attacks, its trigger controller may mill one card; empty libraries skip the impossible optional action."
    ]
  },
  "shared_mechanics": [
    "Live controller and printed-ability availability for normal land-origin permission in actual and borrowed characteristic worlds.",
    "Action::PlayLand retains global timing, allowance, ownership, face and current-zone constraints. No generic cast permission or per-provider use row.",
    "A private EntryMove public-origin marker retains the already public played-land identity through suspended entry choices. The next library top remains deferred until the special action finishes.",
    "Existing typed creation, landfall, counter and optional self-attack mill effects retain exact object incarnations, trigger controllers and batch entry behavior."
  ],
