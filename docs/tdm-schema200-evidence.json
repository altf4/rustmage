  "wire_changes": [
    "Sparse named entry modes, dynamic token recipes/Endure values, copy/Suspend states and haste lifetime",
    "Delve, granted Harmonize, optional Behold and alternative free-cast actions/receipts",
    "Combat insertion, callbacks, temporary-token sacrifice and acquisition-qualified exile links",
    "Counter death facts, color-recipient choice, private search qualifiers and frozen u64 target divisions",
    "New mana restriction variants and nonmana-X sacrifice qualifiers",
    "Chosen-source prevention private/public views and choices; final semantic-reference field/variants remain in owner repair"
  ],
  "projection_contract": [
    "Return compatible observation bytes unchanged after the schema number is projected, preserving all inherited fields and all existing origin values",
    "Reject new sparse fields, enum payloads, exact copied-spell stack targets and widened values outside prior domains",
    "Distinguish old LinkedExileView origins from newly qualified ExileLink and unit hand Behold from tagged cost Behold",
    "Retain original wide i128 damage values without JSON reserialization"
  ],
  "compiled_cases": [
    "prior199_retains_inherited_bytes_and_origin_facts",
    "prior199_refuses_new_semantics_instead_of_erasing_them",
    "prior199_distinguishes_new_origins_from_inherited_link_and_wide_values",
    "prior199_refuses_an_ordinary_color_search_without_a_distinct_color_marker"
