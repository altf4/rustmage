  "shared_mechanics": [
    "An owned cold HandInteraction exposes truthful actor-only ChooseHandCard phases: victim selects required subset privately; commitment reveals exact refs; captured ability controller chooses one central caused-discard.",
    "Optional exile reuses exact-object ExileLink movement and original return zone, returning hand cards to hand and creatures to their owner as new objects. Only actual arrivals in exile create links.",
    "ControllerOfPlayerGroup checks current target controller at announcement and resolution against the original full target bindings; surviving player and creature targets remain independent.",
    "Cloak instruction explicitly consumes all target groups in run_program. Existing exile-until-source-leaves callers share the new refs executor."
  ],
  "wire": {
    "schema": 152,
    "new_action": "ChooseHandCard { object: Option<ObjectRef> }",
    "new_optional_observation": "hand_choice: Option<HandChoiceView>, serialized only when present and only for the actual decision actor.",
    "private_state": "HandInteraction in cold ChoiceState, including exact selected/candidate refs, source incarnation, victim and captured controller.",
    "policy": "Only analogous scoring arm for new action: Some60/None-1. No strategy/bot rewrite.",
    "schema_note": "Same unpublished coordinated152 allocation; no153."
  },
