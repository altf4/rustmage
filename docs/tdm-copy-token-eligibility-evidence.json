  "implementation": [
    "CopyRecipe::can_create_token checks selected copiable kinds, rejecting instant/sorcery copies. It retains noncreature permanent recipes and existing type exceptions.",
    "stage_copy_token_batch stably removes rejected parallel recipe/group pairs before replacement applicability, token allocation or entry scheduling. An empty retained event returns immediately. Retains require no new allocation and preserve valid group/recipe alignment.",
    "Linked physical cards still use the printed front face and exact exile/source/acquired-ability origin. CopyRecipe::new constructs that recipe, so inherited fields retain canonical defaults."
  ],
  "focused_proofs": [
    {
      "test": "linked_nonpermanent_manifested_cards_create_no_tokens_or_replacement_event",
      "result": "Both seats, actual manifested Opt and Divination are legally exiled by the Mardu fixture and linked by exact source/exiled identity and native ability origin. Attack produces no token, AddToken Food, replacement continuation, delayed sacrifice or token allocation; the physical card stays linked in exile."
    },
    {
      "test": "linked_nonpermanent_double_face_front_cannot_use_its_creature_back_to_create_a_token",
      "result": "A complete Double front-Opt/back-Bear-Cub copy recipe at the same shared creation boundary is rejected without any snapshot or replacement-state change, on both seats.",
      "catalogue_limitation": "Pinned catalogue has ten modal double-faced identities, all creature-front Spider-Man cards. No nonpermanent-front modal DFC exists in the pool, so this boundary uses explicit typed CopyFaces::Double and makes no new metadata/admission claim."
    },
    {
      "test": "linked_nonpermanent_filter_preserves_valid_recipe_alignment_and_ability_origin",
      "result": "Matching native Opt is removed, matching native Bear Cub remains aligned, and a valid Hill Giant link from a distinct copied ability origin stays dormant. Exactly Bear Cub plus one replacement-added Food is created and owned-end sacrifice tracks both."
    },
    {
      "test": "exiled_noncreature_physical_card_makes_tapped_nonattacking_copy_even_if_previously_animated",
      "result": "Enhanced positive control: animated Short Bow is exiled as a creature, then its unanimated artifact recipe remains eligible and AddToken Food really applies. Both tokens enter tapped/nonattacking, both are tracked and sacrificed."
    }
  ],
