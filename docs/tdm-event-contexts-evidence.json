  "obligation_map": [
    {
      "card": "Host of the Hereafter",
      "engine": "CreatureDiesWithCounters + immutable EventObjectFacts::DeathCounters + PutEventCountersOnTargets",
      "proof": [
        "simultaneous self and multiple controlled deaths retain independently frozen complete hot/sparse multisets",
        "SBA death with both positive and negative stat counters copies both original kinds before annihilation; independent recipient triggers prove original3/5 amounts",
        "zero-counter and opposing deaths do not trigger; optional recipient omission",
        "later live/source/new incarnation and ceased token slot reuse do not rewrite the old death witness",
        "normal placing-player counter replacements/prohibitions",
        "owned target-choice raw/index/restore after parent disposal with independent sibling and wrong-actor rollback"
      ],
      "remaining_card_wiring": "Existing fixed-entry-counter primitive supplies printed two +1/+1 counters; no card definition changed."
    },
    {
      "card": "Desperate Measures",
      "engine": "GraveyardUnderControllerOnce exact delayed event",
      "proof": [
        "actual paid spell applies +1/-1 and lethal SBA departure draws two for original caster",
        "departure controller qualifies independently of physical owner or current creature type",
        "blink and cleanup terminate exact watch; packet is counterable; old generic DiesOnce compatibility unchanged"
      ],
      "ruling_resolution": "Official TDM note expressly permits the watched object to stop being a creature before entering the graveyard. The new qualified departure event is distinct from generic creature DiesOnce."
    },
    {
      "card": "Furious Forebear",
      "engine": "Explicit graveyard CreatureDies index using pre-event observers and ordinary optional payment/source return",
      "proof": [
        "already-present graveyard observer queues one packet per simultaneous controlled creature death; newly dying Forebear does not observe that event",
        "actual1W payment returns exact source, decline/unfunded paths, old packet may be paid after source leaves without returning new incarnation",
        "graveyard owner supplies ability controller and dying battlefield controller supplies relation",
        "leaving graveyard and ceasing token/card copy unregister all graveyard event indexes before reusable slot occupation",
        "owned optional-payment raw/index/restore with independent decline sibling"
      ]
    },
    {
      "card": "The Sibsig Ceremony",
      "engine": "CreatureEntersYouIfCast uses captured actual caster and controlled entry; DestroyEntering exact untargeted object",
      "proof": [
        "actual paid creature cast destroys entrant and creates one2/2 Zombie Druid; token/direct entry do not recursively qualify",
        "opponent-cast creature redirected under observer control does not qualify",
        "indestructible, departed/blinked entrant and same-object noncreature copy all preserve independent token creation",
        "existing creature-spell generic reduction remains a separate reused primitive"
      ],
      "oracle_xmage_difference": "Java entry predicate checks spell ancestry; typed predicate additionally checks captured caster equals observer controller as Oracle requires."
    }
  ],
