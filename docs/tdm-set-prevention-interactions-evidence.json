  "obligations": [
    {
      "required": "Actual set-only prevention, reflection and draw from a departed printed damage source.",
      "test": "f15_stalwart_second_cast_damage_is_prevented_reflected_and_drawn_after_actual_severance",
      "independent_expected_outcome": "Stalwart is cast for exactly1RW, Krumar Initiate for1B as its second actual spell. New Way Forward costs exactly2URW; Kin-Tree Severance costs exactlyWBG. The real Stalwart trigger remains after actual Severance exile. Choose the exact old battlefield source before or after exile; the new exiled incarnation is not selectable. Prevent its two damage to the protected player. Stalwart controller reaches22 from the printed gain2 before the reflexive packet resolves, then20 after reflected2. Protected player stays20, draws exactly2 actual library cards, and consumes its one shield. Both instants reach graveyard and the second creature resolves as2/2."
    },
    {
      "required": "One exact-source choice is public/private correctly, owned, transactional and restorable.",
      "test": "f15_stalwart_second_cast_damage_is_prevented_reflected_and_drawn_after_actual_severance",
      "independent_expected_outcome": "Only the chooser observes the source-choice frame. Wrong actor and the actual new exile incarnation reject with unchanged snapshot/revision. Raw and indexed children leave parent unchanged, survive parent disposal and match both observations. Restore rejects the stale old revision, then raw replay matches all fields; only the external top-level revision epoch is normalized for restored-child observation comparison, as documented by the engine/harness contract."
    },
    {
      "required": "Actual Headliner may be chosen before or after sacrifice, but its creature-only damage cannot consume a player-damage shield.",
      "test": "f15_headliner_can_be_chosen_before_or_after_sacrifice_but_creature_damage_keeps_player_shield",
      "independent_expected_outcome": "Headliner is actually cast forR and its ability pays1R plus sacrifice; player target rejects. Source choice accepts the exact historical battlefield object while its actual activated ability waits, and rejects the new graveyard incarnation. One surviving own creature makes exactly1 damage to the actual opposing6/7 Marang River Regent. Both players remain20, no library card is drawn, and the chosen player-damage prevention remains unconsumed."
    }
  ],
