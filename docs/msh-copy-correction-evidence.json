  "rules": {
    "source": "https://media.wizards.com/2026/downloads/MagicCompRules%2020260925.pdf",
    "effective": "2026-09-25",
    "707.9d": "A copy replacing creature types excludes the subtype-defining ability. Additive types retain it.",
    "707.8a": "Token face structure follows the actual source permanent, independently of its current copied definition. Other copy effects modify both copied faces."
  },
  "changes": [
    {
      "rule": "Intrinsic subtype CDA",
      "implementation": "CopyRecipe::intrinsic_keywords filters only definition CHANGELING when copy_types().replace; actual raw query, layer-six evaluation and speculative funding share this baseline. Copied exceptions, resolution grants and later providers remain separate.",
      "evidence": "Paid Taskmaster copies both supported changelings in both seats and both evaluation paths; additive Absorbing keeps changeling; Undercover conditional all-types and bounded genuine external keyword grants stay effective; copy-of-copy and Hero-only mana legality remain correct."
    },
    {
      "rule": "Artifact-token replacement classification",
      "implementation": "TokenBatch::artifact_at uses recipe.kinds() when a copy recipe exists, otherwise ordinary token metadata.",
      "evidence": "Paid Self-Reflection copies real artifact-creature positives and Taskmaster Creature-only copies; Helm/Visitor apply only to actual artifact token recipes."
    },
    {
      "rule": "Independent physical token faces",
      "implementation": "Flat private CopyRecipe face template distinguishes Single and Double, with immutable front/back definitions and side. Canonical ordinary recipes keep None. In-place copies preserve recipient physical shape; copied DFC-under-copy freezes the active definition on both faces. Transform and existing FaceView use that template. No hot Object fields added.",
      "evidence": "Paid Taskmaster/Monica/Molten negative pays the inherited transform cost and cannot transform; actual Monica/Molten positive transforms. Paid Shuri overlays a true DFC token with Arc Reactor, and a second paid Molten preserves DFC structure."
    },
    {
      "rule": "Owned and departed-source face facts",
      "implementation": "Materialized recipient-normalized recipes and existing source_copy_recipe capture retain nondefault private face templates, including faces-only recipes.",
      "evidence": "The paid inverse fixture adds a bounded captured-source departure/orphan/restore check. Its final Arc/Arc side-toggle check invokes transform_source directly because Arc has no printed transform ability; this is a bounded continuation, not a playable activation claim."
    }
  ],
