  "shared_rules": [
    "Borrow the committed declaration slice for player-defender filtered attack events; one packet per attacked player, excluding creatures merely entering attacking.",
    "Private EquippedAttacksAlone uses the captured declaration sole attacker. Existing AttachmentTriggerView freezes exact recipient and Equipment ability controller.",
    "UntapEventObject also accepts the exact captured attachment recipient without requiring current creature type; source departure, reattachment and recipient new incarnation cannot redirect it.",
    "Private AttackingAlone target predicate uses the current global combat list and central availability/selection/resolution validation, including actual borrowed abilities.",
    "Attuma reuses current type/control/ability layer modifiers and source indexes; its projected funding worlds agree with actual departures."
  ],
  "oracle_java_discrepancy": "UntapAttachedEffect currently queries later source attachment (or departure attachment LKI). Oracle refers to previously identified attacker, so reattachment must not redirect untap. CR608.2k also means a surviving now-noncreature permanent is still untapped.",
  "rules_authority": {
    "release_notes": "https://magic.wizards.com/en/news/feature/marvel-super-heroes-release-notes",
    "paraphrase": "Spy Kit uses declaration count; later attacking entrants do not alter that event. Crowd uses present attacking membership across defenders and all-invalid targets stop its life gain. Attuma triggers once per attacked player with declared Merfolk, excluding later entrants. Thor reentry creates a fresh object.",
    "cached_rules": "<cache>/rustmage-rules-20260925.txt",
    "rules_sha256": "8d860e451f20f38865b725b42d82feb714c725373dd8f3b32b8652b3eeb070ca",
    "rules": [
      "506.5 attacks alone versus attacking alone",
      "508.1m declared attack trigger boundary",
      "508.4 enters attacking never attacked",
      "603.10 ordinary post-event characteristics",
      "608.2h current or latest departure information",
      "608.2k untargeted event object remains affected after characteristics change",
      "400.7/400.7j zone incarnation and linked public-zone movement"
    ]
  },
